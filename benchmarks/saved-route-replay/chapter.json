rtLine":8,"endLine":8,"startColumn":1,"endColumn":73,"excerpt":"export function totalWithTax(prices: number[], taxRate: number): number {"}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"}]},{"claimId":"claim:79953822-e6f6-44c2-a0cf-45bca6ac58ec","category":{"kind":"codeBehavior"},"prose":"Before calculating the taxed total, totalWithTax checks that taxRate is finite according to Number.isFinite and is not negative.","anchors":[{"anchorId":"anchor:a4581d0d-bcaa-4605-8065-0e20c5539c07","path":"cart.ts","symbolId":"sym:e88f6d3de4018b4f516729605801d57bcc72685c6e6635e37cc8772affe0010a","snapshotId":"snap-1792133675714600000-43528-0","sourceSha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","startByte":334,"endByteInclusive":380,"startLine":9,"endLine":9,"startColumn":3,"endColumn":49,"excerpt":"if (!Number.isFinite(taxRate) || taxRate < 0) {"}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"},{"kind":"symbol","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","symbol_id":"sym:e88f6d3de4018b4f516729605801d57bcc72685c6e6635e37cc8772affe0010a"}]},{"claimId":"claim:ee4a7a10-8de7-4925-ae57-ea8396aaae4f","category":{"kind":"codeBehavior"},"prose":"An invalid taxRate causes totalWithTax to throw a RangeError with the stated message.","anchors":[{"anchorId":"anchor:093f2565-1fb6-4e56-b488-181e7d286f72","path":"cart.ts","symbolId":"sym:e88f6d3de4018b4f516729605801d57bcc72685c6e6635e37cc8772affe0010a","snapshotId":"snap-1792133675714600000-43528-0","sourceSha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","startByte":386,"endByteInclusive":450,"startLine":10,"endLine":10,"startColumn":5,"endColumn":69,"excerpt":"throw new RangeError(\"Tax rate must be finite and non-negative\");"}],"dependencies":[{"kind":"so