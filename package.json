{
  "name": "code-atlas-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:macos": "node scripts/macos-bundle-metadata.mjs write && CI=true tauri build --no-sign --bundles app,dmg && node scripts/macos-bundle-metadata.mjs verify",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "quality:corpus": "node scripts/check-chapter-quality.mjs --corpus",
    "quality:metadata": "node scripts/check-chapter-quality.mjs --metadata",
    "quality:gate": "node scripts/check-chapter-quality.mjs",
    "check": "npm run quality:corpus && npm run test && npm run build && cargo test --manifest-path src-tauri/Cargo.toml --lib && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/themes": "^3.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
