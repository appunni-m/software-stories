d1d4caff241bad9b77233406e","contextSha256":"5cb641ba9570aa35170aedd8b1ac84dc30078800b29238b8404cbaadf021a916","planningContractSha256":"c19d282d051624a77f2afd78ed45ee2550a280806e28a3fbcf4aae0f8723c88c","captureStatus":"complete","coverage":{"selectedFileCount":1,"eligibleCapturedFileCount":1,"unselectedEligibleFileCount":0,"excludedCapturedPathCount":0,"skippedPathCount":1},"indexStatus":"complete"}},"contentSha256":"69cc5bfa8685103920be172d0473104d85c46089fc60ffd969ca3a9bf5abb8e6"},"sections":[{"sectionId":"section:778113b9-6c14-42ea-9a66-5e1a08aafa0e","sectionRevisionId":"sectionrev:233a4648-6bd3-4ed7-b73c-ac0e03b59bd1","order":0,"title":"subtotal: validate prices, then sum","prose":"subtotal is an exported helper that accepts an array of numbers. It checks each price for finiteness and a nonnegative value, throwing a RangeError if any entry fails. If the guard completes without throwing, a reduction starts at zero, adds the prices, and returns the sum.","spokenText":"Every price is checked for finiteness and a nonnegative value. If any entry fails, the function raises a range error; otherwise, it adds the values from zero and returns their sum.","claims":[{"claimId":"claim:aad846d0-a8bd-4c9a-aa5c-ebcf61b64d7d","category":{"kind":"codeBehavior"},"prose":"The exported subtotal function accepts prices as an array of numbers and returns a number.","anchors":[{"anchorId":"anchor:ec20d25d-17ad-4dbd-a894-9f7f2ced9e55","path":"cart.ts","symbolId":null,"snapshotId":"snap-1792133675714600000-43528-0","sourceSha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","startByte":0,"endByteInclusive":51,"startLine":1,"endLine":1,"startColumn":1,"endColumn":52,"excerpt":"export function subtotal(prices: number[]): number {"}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"}]},{"claimId":"claim:5044dd78-654d-49a9-b651-af79019cf9b2","category":{"kind":"codeBehavior"},"prose":"The prices.some predicate checks whether any price is not finite according to Number.isFinite or is below zero.","anchors":[{"anchorId":"anchor:3a91d798-2bc0-4566-90ef-c9bbe0e82b8e","path":"cart.ts","symbolId":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe","snapshotId":"snap-1792133675714600000-43528-0","sourceSha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","startByte":55,"endByteInclusive":121,"startLine":2,"endLine":2,"startColumn":3,"endColumn":69,"excerpt":"if (prices.some((price) => !Number.isFinite(price) || price < 0)) {"}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"},{"kind":"symbol","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","symbol_id":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe"}]},{"claimId":"claim:ffc133b1-8f6e-4319-a89d-bf74366ee140","category":{"kind":"codeBehavior"},"prose":"If the predicate finds an invalid entry, subtotal throws a RangeError with the stated message before reaching the reduction.","anchors":[{"anchorId":"anchor:c10cf75d-09a9-4577-98af-d45cbcb24c66","path":"cart.ts","symbolId":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe","snapshotId":"snap-1792133675714600000-43528-0","sourceSha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","startByte":127,"endByteInclusive":189,"startLine":3,"endLine":3,"startColumn":5,"endColumn":67,"excerpt":"throw new RangeError(\"Prices must be finite and non-negative\");"}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"},{"kind":"symbol","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","symbol_id":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe"}]},{"claimId":"claim:ba09526a-f5b2-419c-aaf8-ac95dbb26d81","category":{"kind":"codeBehavior"},"prose":"After the guard completes without throwing, prices.reduce starts at zero, adds each price to the running total, and returns that sum.","anchors":[{"anchorId":"anchor:e94b8e94-00cc-4c8d-bee7-fad5624e05d1","path":"cart.ts","symbolId":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe","snapshotId":"snap-1792133675714600000-43528-0","sourceSha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","startByte":191,"endByteInclusive":253,"startLine":4,"endLine":5,"startColumn":1,"endColumn":59,"excerpt":"  }\n  return prices.reduce((total, price) => total + price, 0);"}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"},{"kind":"symbol","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","symbol_id":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe"}]}],"dependencies":[{"kind":"sourceFile","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a"},{"kind":"symbol","path":"cart.ts","source_sha256":"bd1859f143bc0f6eb5858ea58da490c7844b91602b5ca19e614e1d46c8f2680a","symbol_id":"sym:3502e10e881a48270a94a5f3a3f9ae96a41c5fa4541c59b5104ffd26f244bbbe"}],"visual":{"schemaVersion":2,"kind":"dataFlow","title":"Price validation and summing","layoutHint":{"direction":"leftToRight"},"nodes":[{"nodeId":"visualnode:f42c6e66-b566-4b77-808d-23f25bbb93c4","label":"prices","detail":"Number array input","hotspotId":"visualhotspot:3ce465fd-2558-4a21-a536-b9e66b587917","evidenceAnchorIds":["anchor:ec20d25d-17ad-4dbd-a894-9f7f2ced9e55"]},{"nodeId":"visualnode:b2afd9de-c31c-4e43-8a55-aafa11b44b4b","label":"Element check","detail":"Tests finiteness and nonnegative values","hotspotId":"visualhotspot:b711bb6b-e7b1-4640-a3e7-9c305801eeb6","evidenceAnchorIds":["anchor:3a91d798-2bc0-4566-90ef-c9bbe0e82b