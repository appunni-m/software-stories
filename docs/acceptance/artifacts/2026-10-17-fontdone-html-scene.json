              {
                "sectionId": "section:e8174905-3223-4d10-bce5-d91ffb808a18",
                "sectionRevisionId": "sectionrev:07c802d9-10a4-4a4a-aea4-4b55726e93cf",
                "order": 0,
                "title": "The PFR0 prefix dispatch",
                "prose": "memory_face checks data.starts_with(b\"PFR0\"); on a match it immediately returns Self::pfr_face(data, face_index, size_pt), forwarding the original byte slice, face index, and point size. The header badge represents only the tested prefix, not a complete observed input.",
                "spokenText": "memory_face checks data.starts_with(b\"PFR0\"); on a match it immediately returns Self::pfr_face(data, face_index, size_pt), forwarding the original byte slice, face index, and point size. The header badge represents only the tested prefix, not a complete observed input.",
                "claims": [
                  {
                    "claimId": "claim:73971bf7-846d-486f-9314-dee5fd5f3a7a",
                    "category": {
                      "kind": "codeBehavior"
                    },
                    "prose": "memory_face checks data.starts_with(b\"PFR0\"); on a match it immediately returns Self::pfr_face(data, face_index, size_pt), forwarding the original byte slice, face index, and point size. The header badge represents only the tested prefix, not a complete observed input.",
                    "anchors": [
                      {
                        "anchorId": "anchor:79efa9b8-431d-49a6-8cef-0ba4183116f7",
                        "path": "src/font.rs",
                        "symbolId": "sym:bdc256ba358aaed5b629ef1c98c10f0cc60d6d3220838d0831707c54ad951481",
                        "snapshotId": "snap-1792140879637485000-11155-0",
                        "sourceSha256": "f4cd937adbfd668f91dbbd28933b7212e919e687364a38affcad7363635664a2",
                        "startByte": 147769,
                        "endByteInclusive": 148749,
                        "startLine": 4053,
                        "endLine": 4078,
                        "startColumn": 5,
                        "endColumn": 10,
                        "excerpt": "pub(crate) fn memory_face(\n        data: &[u8],\n        face_index: usize,\n        size_pt: f32,\n    ) -> Result<Self, FontError> {\n        if read_u32_le(data, 0) == Some(PCF_FILE_VERSION) {\n            return Self::pcf_face(data, face_index, size_pt);\n        }\n        if data.starts_with(b\"PFR0\") {\n            return Self::pfr_face(data, face_index, size_pt);\n        }\n        if matches!(read_u16_le(data, 0), Some(0x0200) | Some(0x0300)) {\n            return Self::winfnt_face(data, face_index, size_pt);\n        }\n        if bdf_text(data)\n            .and_then(first_bdf_keyword)\n            .is_some_and(is_bdf_probe_keyword)\n        {\n            if let Some(error) = parse_bdf_constructor_error(data) {\n                return Err(error);\n            }\n            return Self::bdf_face(data, face_index, size_pt);\n        }\n        if data.starts_with(b\"%!PS-Adobe-3.0 Resource-CIDFont\") {\n            return Self::cid_type1_face(data, face_index, size_pt);\n        }\n"
                      }
                    ],
