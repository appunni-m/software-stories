{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Atlas",
  "version": "0.1.0",
  "identifier": "com.codeatlas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Atlas",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:"],
        "font-src": ["'self'", "data:"],
        "media-src": ["'self'", "data:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http://127.0.0.1:4173", "ws://127.0.0.1:4173"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "copyright": "Copyright (c) 2026 Code Atlas contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "macos-release-metadata.json": "macos-release-metadata.json",
      "resources/third-party/uv-LICENSE-MIT.txt": "resources/third-party/uv-LICENSE-MIT.txt",
      "resources/third-party/uv-LICENSE-APACHE.txt": "resources/third-party/uv-LICENSE-APACHE.txt",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSE_TEXTS.txt": "THIRD_PARTY_LICENSE_TEXTS.txt"
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0"
    }
  }
}
